{
  "name": "broker-app",
  "version": "0.1.0",
  "private": true,
  "description": "Stock Insights — stock financial data app (Next.js + Express + Supabase + MCP)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
