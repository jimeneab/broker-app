PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Supabase (Project Settings > API). The service role key is secret: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for Supabase projects that still sign JWTs with the legacy HS256 secret
# (Project Settings > JWT Keys > Legacy JWT Secret). Leave commented when the project uses JWT signing keys (JWKS).
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# Market data providers (secret)
FINNHUB_API_KEY=your-finnhub-key
TWELVEDATA_API_KEY=your-twelvedata-key
# Only for applying migrations with the Supabase CLI (not read by the API). Session pooler string; URL-encode special chars in the password.
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
